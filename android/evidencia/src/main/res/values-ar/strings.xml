    <!-- Identidad -->
    <string name="x39_identidad_aviso">هذا المفتاح موجود على هذا الهاتف فقط. إذا فُقد أو حُذف، تُفقد الهوية: الإيصالات الصادرة تبقى صالحة إذا صدّرت المفتاح العام، لكن الأدلة الجديدة ستحمل هوية أخرى. لا توجد نسخة في السحابة، عن قصد.</string>
    <string name="x39_tu_identidad">هويتك</string>
    <string name="x39_identidad_sin_cuenta">دون حساب ودون تسجيل</string>
    <string name="x39_identidad_intro">هويتك مفتاح توقيع ML-DSA-87 يُنشأ الآن على هذا الهاتف، ويوقّع كل دليل. لا خادم ولا تسجيل: المفتاح هو الهوية، لا أكثر.</string>
    <string name="x39_crear_identidad">إنشاء الهوية</string>
    <string name="x39_creando_clave">جارٍ إنشاء المفتاح…</string>
    <string name="x39_error_crear_identidad">تعذّر إنشاء الهوية: %1$s</string>
    <string name="x39_identidad_huella_titulo">بصمة مفتاحك</string>
    <string name="x39_identidad_huella_nota">قيمة SHA-256 للمفتاح العام. من يستلم إيصالًا يقارن البصمة التي فيه بهذه.</string>
    <string name="x39_identidad_clave_publica">المفتاح العام</string>
    <string name="x39_identidad_qr_desc">رمز QR بالمفتاح العام</string>
    <string name="x39_identidad_clave_info">ML-DSA-87 · %1$s بايت. رمز QR يحمل المفتاح كاملًا (الإصدار 40، 177 × 177 وحدة): قرّب الكاميرا جيدًا عند مسحه.</string>
    <string name="x39_exportar_clave_bin">تصدير المفتاح العام (.bin)</string>
    <string name="x39_comprobar_tamanos_titulo">التحقق من الأحجام</string>
    <string name="x39_comprobar_tamanos_texto">في ML-DSA-87 يكون المفتاح العام %1$s بايت والتوقيع %2$s بايت. تُقاس هنا، على هذا الهاتف، بتوقيع تجريبي.</string>
    <string name="x39_comprobar_en_este_movil">التحقق على هذا الهاتف</string>
    <string name="x39_donde_vive">أين يوجد</string>
    <string name="x39_donde_vive_texto">بذرة المفتاح مشفّرة بمفتاح من Keystore في Android (%1$s). لا يوقّع Android بعد بخوارزمية ML-DSA داخل Keystore، لذا يُحسب التوقيع داخل التطبيق والبذرة مفكوكة التشفير في الذاكرة فقط، وتُمحى عند الانتهاء.</string>
